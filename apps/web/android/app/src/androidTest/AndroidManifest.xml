<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="local.investment.personal.SavedWatchlistTestObservationProvider"
            android:authorities="local.investment.personal.test.watchlist-export-observer"
            android:exported="true" />
        <provider
            android:name="local.investment.personal.SavedWatchlistTestDocumentsProvider"
            android:authorities="local.investment.personal.test.watchlist-export"
            android:exported="true"
            android:grantUriPermissions="true"
            android:label="Investment test exports"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
