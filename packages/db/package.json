{
  "name": "@research-cockpit/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsx src/check-migrations.ts && tsx src/check-postgres-acceptance.ts",
