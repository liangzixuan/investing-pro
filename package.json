{
  "name": "research-cockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev:demo": "pnpm --parallel --stream --filter @research-cockpit/api --filter @research-cockpit/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guardrails": "pnpm guardrails:release-classification && pnpm guardrails:boundaries && pnpm guardrails:fixtures && pnpm guardrails:filing-parser-fixtures && pnpm guardrails:filing-parser-normalization-execution-fixtures && pnpm guardrails:filing-parser-cross-engine-execution-fixtures && pnpm guardrails:filing-payload-custody-fixtures && pnpm guardrails:migrations && pnpm guardrails:postgres-acceptance && pnpm guardrails:licenses",
    "guardrails:release-classification": "tsx scripts/release-classification.ts",
    "release:classify": "tsx scripts/release-classification.ts",
    "test:release-classification": "vitest run --config scripts/release-classification/vitest.config.ts",
    "guardrails:boundaries": "tsx scripts/verify-boundaries.ts",
    "guardrails:fixtures": "tsx scripts/verify-fixtures.ts",
    "guardrails:filing-parser-fixtures": "tsx scripts/verify-filing-parser-fixtures.ts",
    "guardrails:filing-parser-normalization-execution-fixtures": "tsx scripts/verify-filing-parser-normalization-execution-fixtures.ts",
    "guardrails:filing-parser-cross-engine-execution-fixtures": "tsx scripts/verify-filing-parser-cross-engine-execution-fixtures.ts",
    "guardrails:filing-payload-custody-fixtures": "tsx scripts/verify-filing-payload-custody-fixtures.ts",
    "guardrails:migrations": "tsx packages/db/src/check-migrations.ts",
    "guardrails:postgres-acceptance": "tsx packages/db/src/check-postgres-acceptance.ts",
    "guardrails:licenses": "tsx scripts/verify-licenses.ts",
    "filing-parser:acceptance": "tsx packages/filing-parser/src/run-filing-parser-acceptance.ts",
    "filing-parser:evidence-review": "tsx packages/filing-parser/src/run-filing-parser-evidence-review.ts",
    "filing-parser-normalization-execution:acceptance": "tsx packages/filing-parser-normalization-execution-acceptance/src/run-filing-parser-normalization-execution-acceptance.ts",
    "filing-parser-normalization-execution:evidence-review": "tsx packages/filing-parser-normalization-execution-acceptance/src/run-filing-parser-normalization-execution-evidence-review.ts",
    "filing-parser-cross-engine-execution:acceptance": "tsx packages/filing-parser-cross-engine-execution-acceptance/src/run-filing-parser-cross-engine-execution-acceptance.ts",
    "filing-parser-cross-engine-execution:evidence-review": "tsx packages/filing-parser-cross-engine-execution-acceptance/src/run-filing-parser-cross-engine-execution-evidence-review.ts",
    "filing-payload-custody:acceptance": "tsx packages/filing-payload-custody/src/run-filing-payload-custody-acceptance.ts",
    "filing-payload-custody:evidence-review": "tsx packages/filing-payload-custody/src/run-filing-payload-custody-evidence-review.ts",
    "test": "pnpm test:release-classification && pnpm -r --workspace-concurrency=1 --if-present test",
    "test:delivery": "vitest run --config scripts/appwrite/vitest.config.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm guardrails && pnpm typecheck && pnpm peers check && pnpm test && pnpm build",
    "test:browserstack:web:list": "playwright test --config=scripts/browserstack/playwright.config.ts --list",
    "test:browserstack:web:check": "tsx scripts/browserstack/run-web.ts --check",
    "test:browserstack:web": "tsx scripts/browserstack/run-web.ts --run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "browserstack-node-sdk": "1.70.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.6",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
